#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
EXTRACTOR_DIR="$TOOLS_ROOT/subtitle-extractor"
VENV_DIR="$EXTRACTOR_DIR/.venv"

CHECKS="[]"
ACTIONS="[]"
STATUS="READY"
BASE_READY=true
ASR_AVAILABLE=true

add_check() {
    local name="$1"
    local status="$2"
    local message="$3"
    python3 -c "
import json, sys
checks = json.loads(sys.argv[1])
checks.append({'name': sys.argv[2], 'status': sys.argv[3], 'message': sys.argv[4]})
print(json.dumps(checks))
" "$CHECKS" "$name" "$status" "$message"
}

add_action() {
    local action="$1"
    python3 -c "
import json, sys
actions = json.loads(sys.argv[1])
actions.append(sys.argv[2])
print(json.dumps(actions))
" "$ACTIONS" "$action"
}

# 1. Check Python 3 (>= 3.10)
if command -v python3 &>/dev/null; then
    PY_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    PY_OK=$(python3 -c 'import sys; print("1" if sys.version_info >= (3, 10) else "0")')
    if [[ "$PY_OK" == "1" ]]; then
        CHECKS=$(add_check "python_runtime" "ok" "Python $PY_VER found at $(command -v python3)")
    else
        CHECKS=$(add_check "python_runtime" "failed" "Python version $PY_VER is older than required 3.10")
        ACTIONS=$(add_action "Install Python 3.10 or higher")
        STATUS="NEEDS_USER_ACTION"
        BASE_READY=false
    fi
else
    CHECKS=$(add_check "python_runtime" "failed" "python3 executable not found in PATH")
    ACTIONS=$(add_action "Install Python 3.10 or higher")
    STATUS="NEEDS_USER_ACTION"
    BASE_READY=false
fi

# 2. Check Virtualenv
if [[ "$BASE_READY" == true ]]; then
    if [[ -d "$VENV_DIR" && -x "$VENV_DIR/bin/python" && -x "$VENV_DIR/bin/pip" ]]; then
        CHECKS=$(add_check "virtualenv" "ok" "Virtual environment exists at $VENV_DIR")
    else
        CHECKS=$(add_check "virtualenv" "failed" "Virtual environment missing or incomplete at $VENV_DIR")
        ACTIONS=$(add_action "Run capability setup entrypoint (./setup)")
        if [[ "$STATUS" != "NEEDS_USER_ACTION" ]]; then
            STATUS="NEEDS_SETUP"
        fi
        BASE_READY=false
    fi
fi

# 3. Check Base Dependencies
if [[ "$BASE_READY" == true ]]; then
    if "$VENV_DIR/bin/python" -c 'import yt_dlp, httpx' &>/dev/null; then
        CHECKS=$(add_check "base_dependencies" "ok" "Base extraction dependencies satisfied in venv")
    else
        CHECKS=$(add_check "base_dependencies" "failed" "Core extraction dependencies missing in venv")
        ACTIONS=$(add_action "Run capability setup entrypoint (./setup)")
        if [[ "$STATUS" != "NEEDS_USER_ACTION" ]]; then
            STATUS="NEEDS_SETUP"
        fi
        BASE_READY=false
    fi
fi

# 4. Check Optional Media Tools (ffmpeg / ffprobe) for ASR
if [[ -d "$HOME/.local/bin" && ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

if command -v ffmpeg &>/dev/null && command -v ffprobe &>/dev/null; then
    CHECKS=$(add_check "media_tools" "ok" "ffmpeg and ffprobe found at $(command -v ffmpeg)")
else
    CHECKS=$(add_check "media_tools" "missing" "ffmpeg or ffprobe not found in PATH; native subtitles still supported, but offline ASR will be disabled")
    ASR_AVAILABLE=false
fi

# 5. Check Optional FireRedASR2 Model
if [[ -d "$EXTRACTOR_DIR/.models" && -f "$EXTRACTOR_DIR/.models/FireRedASR2-AED/model.pth" ]]; then
    CHECKS=$(add_check "asr_model" "ok" "Pre-downloaded FireRedASR2-AED model found")
else
    CHECKS=$(add_check "asr_model" "missing" "Offline ASR model not pre-downloaded; will download lazily if ASR fallback is triggered")
fi

python3 -c "
import json, sys
report = {
    'status': sys.argv[1],
    'base_ready': sys.argv[2] == 'true',
    'asr_available': sys.argv[3] == 'true',
    'checks': json.loads(sys.argv[4]),
    'actions': json.loads(sys.argv[5])
}
print(json.dumps(report, indent=2))
" "$STATUS" "$BASE_READY" "$ASR_AVAILABLE" "$CHECKS" "$ACTIONS"
